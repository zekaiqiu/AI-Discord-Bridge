#!/usr/local/bin/python3
"""robustness — walk-forward + bootstrap MC robustness panel.

Given a returns series, runs:
  1. Walk-forward windowed Sharpe (rolling, default 252 trading days).
     Plots Sharpe over time so you can see whether the strategy's edge
     was concentrated in one regime vs. consistent.
  2. Stationary bootstrap on the returns (1000 paths by default), with
     bootstrapped 95% confidence intervals for:
        - annualised return
        - annualised vol
        - Sharpe
        - max drawdown
        - Calmar
     Also reports the share of bootstrap paths with negative cumulative
     return — the most direct overfit indicator.

Output: a multi-page PDF (one panel per chart + one stats table) plus
a sidecar JSON with raw stats. PDF renders inline in the chat UI;
JSON renders as a structured tree.

Usage:
  robustness returns.parquet
  robustness ret.csv --window 126 --paths 5000 --block 20 --out rob.pdf
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import numpy as np
import pandas as pd

_ANNUAL = 252  # trading days per year — daily returns assumption


_RETURN_COL_CANDIDATES = (
    "returns", "return", "ret", "r",
    "daily_return", "daily_returns",
    "pnl_pct", "pct_change", "strategy",
)


def _read_returns(path: Path) -> pd.Series:
    suffix = path.suffix.lower()
    if suffix == ".parquet":
        df = pd.read_parquet(path)
    elif suffix in (".feather", ".arrow"):
        df = pd.read_feather(path)
    elif suffix in (".csv", ".tsv"):
        sep = "\t" if suffix == ".tsv" else ","
        df = pd.read_csv(path, sep=sep)
    elif suffix in (".xlsx", ".xls"):
        df = pd.read_excel(path)
    else:
        raise SystemExit(f"unsupported input extension: {suffix}")

    if not isinstance(df.index, pd.DatetimeIndex) and len(df.columns):
        first = df.columns[0]
        try:
            parsed = pd.to_datetime(df[first], errors="raise")
            df = df.set_index(parsed).drop(columns=[first])
        except (ValueError, TypeError):
            pass
    if not isinstance(df.index, pd.DatetimeIndex):
        idx = pd.bdate_range(end=pd.Timestamp.today().normalize(), periods=len(df))
        df.index = idx

    col = None
    for c in df.columns:
        if str(c).lower() in _RETURN_COL_CANDIDATES:
            col = c
            break
    if col is None:
        for c in df.columns:
            if pd.api.types.is_numeric_dtype(df[c]):
                col = c
                break
    if col is None:
        raise SystemExit(
            "no numeric returns column found; expected one of "
            f"{list(_RETURN_COL_CANDIDATES)} or any numeric column"
        )

    s = df[col].astype(float).dropna()
    s.index = pd.DatetimeIndex(s.index).tz_localize(None)
    s.name = "returns"
    s = s.sort_index()
    if s.abs().median() > 1.0:
        s = s / 100.0  # decimalize percent-quoted inputs
    return s


def _stats(returns: np.ndarray) -> dict[str, float]:
    """Annualised-return / vol / Sharpe / max DD / Calmar for one path."""
    if len(returns) == 0:
        return {"ann_return": 0.0, "ann_vol": 0.0, "sharpe": 0.0,
                "max_dd": 0.0, "calmar": 0.0, "total_return": 0.0}
    eq = np.cumprod(1.0 + returns)
    total = eq[-1] - 1.0
    n = len(returns)
    ann_return = eq[-1] ** (_ANNUAL / n) - 1.0
    ann_vol = returns.std(ddof=1) * np.sqrt(_ANNUAL) if n > 1 else 0.0
    sharpe = (ann_return / ann_vol) if ann_vol > 0 else 0.0
    peak = np.maximum.accumulate(eq)
    dd = eq / peak - 1.0
    max_dd = dd.min()
    calmar = (ann_return / abs(max_dd)) if max_dd < 0 else float("inf")
    if not np.isfinite(calmar):
        calmar = 0.0
    return {
        "ann_return": float(ann_return),
        "ann_vol": float(ann_vol),
        "sharpe": float(sharpe),
        "max_dd": float(max_dd),
        "calmar": float(calmar),
        "total_return": float(total),
    }


def _stationary_bootstrap_indices(n: int, block: int, rng: np.random.Generator) -> np.ndarray:
    """Politis-Romano stationary bootstrap of length n with mean-block size."""
    p = 1.0 / max(block, 1)
    idx = np.empty(n, dtype=np.int64)
    cur = rng.integers(0, n)
    for t in range(n):
        idx[t] = cur
        if rng.random() < p:
            cur = rng.integers(0, n)
        else:
            cur = (cur + 1) % n
    return idx


def _bootstrap_distribution(
    returns: np.ndarray, paths: int, block: int, seed: int,
) -> dict[str, np.ndarray]:
    rng = np.random.default_rng(seed)
    n = len(returns)
    cols = ("ann_return", "ann_vol", "sharpe", "max_dd", "calmar", "total_return")
    out: dict[str, list[float]] = {c: [] for c in cols}
    for _ in range(paths):
        idx = _stationary_bootstrap_indices(n, block, rng)
        s = _stats(returns[idx])
        for c in cols:
            out[c].append(s[c])
    return {c: np.asarray(out[c], dtype=float) for c in cols}


def _walk_forward(returns: pd.Series, window: int) -> pd.Series:
    """Rolling annualised Sharpe over `window` trading days."""
    if len(returns) < window:
        return pd.Series(dtype=float)
    mean = returns.rolling(window).mean()
    std = returns.rolling(window).std(ddof=1)
    sharpe = (mean / std) * np.sqrt(_ANNUAL)
    return sharpe.dropna()


def _ci(samples: np.ndarray, lo: float = 0.025, hi: float = 0.975) -> tuple[float, float, float]:
    return (
        float(np.quantile(samples, lo)),
        float(np.median(samples)),
        float(np.quantile(samples, hi)),
    )


def _render_pdf(
    out: Path,
    returns: pd.Series,
    walk: pd.Series,
    boot: dict[str, np.ndarray],
    in_sample: dict[str, float],
    window: int,
    paths: int,
    block: int,
) -> None:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.backends.backend_pdf import PdfPages

    metrics = ("ann_return", "ann_vol", "sharpe", "max_dd", "calmar")
    pretty = {
        "ann_return": "Annualised Return",
        "ann_vol": "Annualised Vol",
        "sharpe": "Sharpe",
        "max_dd": "Max Drawdown",
        "calmar": "Calmar",
        "total_return": "Total Return",
    }
    fmt_pct = {"ann_return", "ann_vol", "max_dd", "total_return"}

    with PdfPages(out) as pdf:
        # --- Page 1: equity curve + walk-forward Sharpe ---------------
        fig, axes = plt.subplots(2, 1, figsize=(10, 7))
        eq = (1 + returns).cumprod()
        axes[0].plot(eq.index, eq.values, color="#1f77b4")
        axes[0].set_title(
            f"Equity curve  (in-sample: ann={in_sample['ann_return']:.2%}, "
            f"vol={in_sample['ann_vol']:.2%}, Sharpe={in_sample['sharpe']:.2f})"
        )
        axes[0].set_ylabel("Equity (×)")
        axes[0].grid(alpha=0.3)

        if not walk.empty:
            axes[1].plot(walk.index, walk.values, color="#2ca02c")
            axes[1].axhline(0, color="black", lw=0.8)
            axes[1].axhline(in_sample["sharpe"], color="#1f77b4", lw=0.8,
                            ls="--", label=f"full-sample Sharpe={in_sample['sharpe']:.2f}")
            axes[1].set_title(f"Walk-forward Sharpe ({window}-day rolling)")
            axes[1].set_ylabel("Annualised Sharpe")
            axes[1].legend(loc="best")
            axes[1].grid(alpha=0.3)
        else:
            axes[1].text(0.5, 0.5,
                         f"need ≥ {window} returns for walk-forward\n"
                         f"have {len(returns)}",
                         ha="center", va="center", transform=axes[1].transAxes)
            axes[1].set_axis_off()

        fig.tight_layout()
        pdf.savefig(fig); plt.close(fig)

        # --- Page 2: bootstrap distributions (one subplot per metric) -
        fig, axes = plt.subplots(2, 3, figsize=(11, 7))
        axes = axes.ravel()
        for ax, m in zip(axes, metrics):
            samples = boot[m]
            lo, med, hi = _ci(samples)
            ax.hist(samples, bins=50, color="#9ecae1", edgecolor="white")
            ax.axvline(in_sample[m], color="#d62728", lw=2,
                       label=f"in-sample {in_sample[m]:.{2 if m in fmt_pct else 3}f}"
                       + ("%" if m in fmt_pct else ""))
            ax.axvline(med, color="black", lw=1.5, ls="--",
                       label=f"boot median {med:.{2 if m in fmt_pct else 3}f}"
                       + ("%" if m in fmt_pct else ""))
            ax.axvspan(lo, hi, alpha=0.18, color="#9ecae1")
            ax.set_title(f"{pretty[m]}\n95% CI [{lo:.{2 if m in fmt_pct else 3}f}, "
                         f"{hi:.{2 if m in fmt_pct else 3}f}]")
            ax.legend(fontsize=7, loc="best")
            ax.grid(alpha=0.3)
        # Sixth panel: terminal-equity histogram and "share of paths < 0".
        last_ax = axes[-1]
        terminals = boot["total_return"]
        share_neg = float((terminals < 0).mean())
        last_ax.hist(terminals, bins=50, color="#fdae6b", edgecolor="white")
        last_ax.axvline(0, color="black", lw=1.5)
        last_ax.axvline(in_sample["total_return"], color="#d62728", lw=2,
                        label=f"in-sample {in_sample['total_return']:.2%}")
        last_ax.set_title(
            f"Total Return distribution\n"
            f"share of bootstrap paths < 0:  {share_neg:.1%}"
        )
        last_ax.legend(fontsize=7, loc="best")
        last_ax.grid(alpha=0.3)
        fig.suptitle(
            f"Stationary bootstrap  ({paths:,} paths · mean block {block} days · "
            f"n={len(returns)} returns)",
            fontsize=11,
        )
        fig.tight_layout(rect=(0, 0, 1, 0.96))
        pdf.savefig(fig); plt.close(fig)

        # --- Page 3: stats table -------------------------------------
        rows = [
            ("Metric", "In-sample", "Boot median", "95% CI low", "95% CI high"),
        ]
        for m in metrics + ("total_return",):
            lo, med, hi = _ci(boot[m])
            v = in_sample[m]
            if m in fmt_pct:
                rows.append((pretty[m],
                             f"{v:.2%}", f"{med:.2%}", f"{lo:.2%}", f"{hi:.2%}"))
            else:
                rows.append((pretty[m],
                             f"{v:.3f}", f"{med:.3f}", f"{lo:.3f}", f"{hi:.3f}"))
        rows.append(("Share of paths < 0", "", f"{share_neg:.1%}", "", ""))

        fig, ax = plt.subplots(figsize=(10, 0.45 * len(rows) + 1))
        ax.set_axis_off()
        table = ax.table(cellText=rows[1:], colLabels=rows[0], loc="center",
                         cellLoc="center", colLoc="center")
        table.auto_set_font_size(False)
        table.set_fontsize(9)
        table.scale(1, 1.4)
        ax.set_title("Robustness summary", fontsize=12, pad=10)
        fig.tight_layout()
        pdf.savefig(fig); plt.close(fig)


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="robustness", description=__doc__)
    p.add_argument("returns",
                   help="path to returns file (.parquet/.csv/.tsv/.feather/.xlsx)")
    p.add_argument("--window", type=int, default=252,
                   help="walk-forward rolling window in trading days (default 252)")
    p.add_argument("--paths", type=int, default=1000,
                   help="number of bootstrap paths (default 1000)")
    p.add_argument("--block", type=int, default=10,
                   help="stationary-bootstrap mean block size in days (default 10)")
    p.add_argument("--seed", type=int, default=42)
    p.add_argument("--out", default=None,
                   help="output PDF path (default: <in>.robustness.pdf)")
    p.add_argument("--json-out", default=None,
                   help="optional JSON sidecar (default: <out>.json)")
    args = p.parse_args(argv)

    in_path = Path(args.returns).expanduser().resolve()
    if not in_path.exists():
        raise SystemExit(f"input not found: {in_path}")

    returns = _read_returns(in_path)
    if returns.empty:
        raise SystemExit("returns series is empty after dropna")
    if len(returns) < 30:
        print(
            f"warning: only {len(returns)} returns — robustness stats are "
            "uninformative on tiny samples",
            file=sys.stderr,
        )

    arr = returns.values.astype(float)
    in_sample = _stats(arr)
    walk = _walk_forward(returns, args.window)
    boot = _bootstrap_distribution(arr, args.paths, args.block, args.seed)

    out = (Path(args.out).expanduser().resolve() if args.out
           else in_path.with_suffix("").with_suffix(".robustness.pdf"))
    out.parent.mkdir(parents=True, exist_ok=True)
    _render_pdf(out, returns, walk, boot, in_sample,
                args.window, args.paths, args.block)

    json_out = (Path(args.json_out).expanduser().resolve() if args.json_out
                else out.with_suffix(".json"))
    summary = {
        "input": str(in_path),
        "n_returns": int(len(returns)),
        "window": int(args.window),
        "paths": int(args.paths),
        "block": int(args.block),
        "in_sample": in_sample,
        "bootstrap_ci": {
            m: {"q025": float(np.quantile(boot[m], 0.025)),
                "q500": float(np.median(boot[m])),
                "q975": float(np.quantile(boot[m], 0.975))}
            for m in ("ann_return", "ann_vol", "sharpe",
                      "max_dd", "calmar", "total_return")
        },
        "share_paths_negative": float((boot["total_return"] < 0).mean()),
    }
    json_out.write_text(json.dumps(summary, indent=2))

    rel_out = out
    try:
        rel_out = out.relative_to(Path.cwd())
    except ValueError:
        pass
    print(f"robustness → {rel_out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
